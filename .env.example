# Copy this file to .env.local and fill in your own values. Never commit .env.local.
# Required: DATABASE_URL and the KINDE_ values. Everything else is optional.

# Neon (or any Postgres) connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Kinde application settings
KINDE_CLIENT_ID=
KINDE_CLIENT_SECRET=
KINDE_ISSUER_URL=https://your-subdomain.kinde.com
KINDE_SITE_URL=http://localhost:3000
KINDE_POST_LOGIN_REDIRECT_URL=http://localhost:3000/dashboard
KINDE_POST_LOGOUT_REDIRECT_URL=http://localhost:3000/signed-out

# Optional. Signs demo guest cookies. Falls back to KINDE_CLIENT_SECRET if unset.
GUEST_SECRET=

# Optional: connected apps (Zoho). Leave all three empty to run without them.
# CONNECTIONS_KEY is 32 random bytes in base64 and encrypts every stored connection key.
# Make one with: openssl rand -base64 32
CONNECTIONS_KEY=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# Not needed: VERCEL_GIT_COMMIT_SHA is set by Vercel itself and only versions the offline page.
