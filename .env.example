# Copy this file to .env.local and fill in your own values. Never commit .env.local.

# Neon (or any Postgres) connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Kinde application settings
KINDE_CLIENT_ID=
KINDE_CLIENT_SECRET=
KINDE_ISSUER_URL=https://your-subdomain.kinde.com
KINDE_SITE_URL=http://localhost:3000
KINDE_POST_LOGIN_REDIRECT_URL=http://localhost:3000/dashboard
KINDE_POST_LOGOUT_REDIRECT_URL=http://localhost:3000/signed-out

# Signs demo guest cookies. Falls back to KINDE_CLIENT_SECRET if unset.
GUEST_SECRET=

# Connected apps. CONNECTIONS_KEY is 32 random bytes in base64 and encrypts every stored
# connection key. Make one with: openssl rand -base64 32
CONNECTIONS_KEY=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
